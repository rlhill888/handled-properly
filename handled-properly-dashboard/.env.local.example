# Copy to .env.local and fill in. Never commit .env.local (already gitignored).

# --- Supabase ---
# Local dev values (from `npx supabase status` once `supabase start` finishes)
# come pre-filled below; swap for the hosted project's values when ready to
# deploy (Project Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client/browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- AWS SES (mass email) ---
# Uses the "devenv" AWS CLI profile locally; in deployment this becomes an
# IAM role instead of static keys.
AWS_REGION=us-east-1
AWS_PROFILE=devenv
SES_FROM_EMAIL=

# --- Anthropic (AI email drafting) ---
ANTHROPIC_API_KEY=
